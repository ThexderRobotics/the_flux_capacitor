{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "the-flux-capacitor",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "zanderbooyzen@gmail.com",
      "allowed_sender_addresses": ["mail@zanderbooyzen.com"]
    }
  ]
}
